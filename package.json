{
  "name": "livedesk-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Статический лендинг платформы видеоконференций LiveDesk",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"*.{js,jsx,css,html,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.{js,jsx,css,html,json}\""
  },
  "dependencies": {
    "dompurify": "^3.4.3",
    "marked": "^14.1.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "vite": "^7.3.1"
  }
}
